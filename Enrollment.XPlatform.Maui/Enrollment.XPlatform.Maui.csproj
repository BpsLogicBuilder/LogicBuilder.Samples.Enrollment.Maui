<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst;net10.0</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.26100.0</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net10.0-tizen</TargetFrameworks> -->
		<OutputType Condition="$(TargetFramework) == 'net10.0-android' OR $(TargetFramework) == 'net10.0-ios' OR $(TargetFramework) == 'net10.0-maccatalyst' OR $(TargetFramework) == 'net10.0-windows10.0.26100.0'">Exe</OutputType>
		<OutputType Condition="$(TargetFramework) == 'net10.0'">Library</OutputType>
		<RootNamespace>Enrollment.XPlatform</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>

		<!-- Display name -->
		<ApplicationTitle>Enrollment.XPlatform</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.enrollment.xplatform</ApplicationId>
		<ApplicationIdGuid>4B6B009E-4336-4916-9F12-68A19555D429</ApplicationIdGuid>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.4</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.4</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">33.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.26100.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.26100.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
		<WindowsPackageType>None</WindowsPackageType>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup Condition="$(TargetFramework) == 'net10.0-android' OR $(TargetFramework) == 'net10.0-windows10.0.26100.0'">
		<IntermediateOutputPath>C:\MauiEnrollment\obj\</IntermediateOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.png" BaseSize="456,456" Color="#000000" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.png" BaseSize="128,128" Color="#000000" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\hamburger.png" BaseSize="14,15" />
		<MauiImage Update="Resources\Images\splash_logo.png" BaseSize="310,150" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Akavache.Sqlite3" Version="13.0.0" />
		<PackageReference Include="Akavache.SystemTextJson" Version="13.0.0" />
		<PackageReference Include="LogicBuilder.App.Bsl.Business" Version="1.0.3" />
		<PackageReference Include="LogicBuilder.App.Maui" Version="1.0.1" />
		<PackageReference Include="LogicBuilder.App.Maui.Forms.Configuration" Version="1.1.0" />
		<PackageReference Include="LogicBuilder.EntityFrameworkCore" Version="8.0.3" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.120" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.120" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Polly" Version="8.9.0" />
		<PackageReference Include="System.Reactive" Version="7.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Enrollment.XPlatform.Flow\Enrollment.XPlatform.Flow.csproj" />
	</ItemGroup>

</Project>
